# Copie para .env dentro de backend/ para execução local.
# Credenciais reais ficam somente no .env ou nas variáveis do serviço de hospedagem.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PORT=8000
# Banco local do Compose. Em produção, use a conexão PostgreSQL do Supabase com TLS.
DATABASE_URL=postgresql+psycopg://tsi:tsi_local@localhost:5433/tsi
